# LLM API Configuration
# Copy this file to .env and fill in your values

# Required: your LLM API key
LLM_API_KEY=your_api_key_here

# API base URL (default: DeepSeek; any OpenAI-compatible endpoint works)
LLM_BASE_URL=https://api.deepseek.com

# Model name
LLM_MODEL_NAME=deepseek-chat

# ── Gemini (via OpenAI-compatible proxy) ──────────────────────────
GEMINI_API_KEY=your_gemini_proxy_key_here
GEMINI_BASE_URL=https://api.v3.cm/v1
GEMINI_MODEL_NAME=gemini-3.1-pro-preview
